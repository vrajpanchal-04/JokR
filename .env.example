# Copy to .env and change the password. .env is git-ignored (C10/§10: no secrets in git).
POSTGRES_USER=jokr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jokr

# Used by the api container. Host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://jokr:change-me@db:5432/jokr

# Directory holding caps.yaml, fit_rules.yaml, scoring.yaml, sources.yaml.
JOKR_CONFIG_DIR=config
