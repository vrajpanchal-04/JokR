# Copy to .env and change both passwords. .env is git-ignored (§10: no secrets in git).

# Database owner. Used only by migrations.
POSTGRES_USER=jokr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jokr
MIGRATION_DATABASE_URL=postgresql+psycopg://jokr:change-me@db:5432/jokr

# Restricted role the API runs as (SELECT/INSERT only; cannot bypass C10).
JOKR_APP_PASSWORD=change-me-too
DATABASE_URL=postgresql+psycopg://jokr_app:change-me-too@db:5432/jokr

# Directory holding caps.yaml, fit_rules.yaml, scoring.yaml, sources.yaml.
JOKR_CONFIG_DIR=config
