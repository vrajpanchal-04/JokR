# Copy to .env and change both passwords. .env is git-ignored (§10: no secrets in git).

# Database owner. Used only by migrations.
POSTGRES_USER=jokr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jokr
MIGRATION_DATABASE_URL=postgresql+psycopg://jokr:change-me@db:5432/jokr

# Restricted role the API runs as (SELECT/INSERT only; cannot bypass C10).
JOKR_APP_PASSWORD=change-me-too
DATABASE_URL=postgresql+psycopg://jokr_app:change-me-too@db:5432/jokr

# Scout (P1). Its own DB login: insert-only on signals, cannot touch sources.
JOKR_SCOUT_PASSWORD=change-me-three
SCOUT_DATABASE_URL=postgresql+psycopg://jokr_scout:change-me-three@db:5432/jokr
# Keys the HMAC that hides author names. At least 32 random bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it breaks per-author counts across old and new signals.
AUTHOR_HASH_SALT=replace-with-48-random-url-safe-characters-xxxxxxxxxx
# Reddit (optional; off by default). Format: platform:app-id:version (by /u/name)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Directory holding caps.yaml, fit_rules.yaml, scoring.yaml, sources.yaml.
JOKR_CONFIG_DIR=config
